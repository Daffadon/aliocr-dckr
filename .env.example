# Copy to .env and fill in. Loaded via --env-file (.env) into container.
# Built-in provider: only key + provider/model needed.
OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GEMINI_API_KEY=xxx
# DEEPSEEK_API_KEY=xxx
# DASHSCOPE_API_KEY=xxx
OCR_PROVIDER=openai
OCR_MODEL=gpt-4o
OCR_OUTPUT=review.json
# Custom OpenAI-compatible endpoint: comment built-in above, uncomment below.
# OCR_PROVIDER=my-gateway
# OCR_MODEL=openai/gpt-4o
# OCR_CUSTOM_URL=https://gateway.internal:8000/v1
# OCR_CUSTOM_PROTOCOL=openai
# OCR_CUSTOM_API_KEY=sk-xxx
